rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Fields the public contact form is allowed to set on creation.
    function isValidNewLead(data) {
      return data.keys().hasOnly(['name', 'phone', 'service', 'message', 'status', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 30
        && data['service'] is string
        && data['service'] in [
          'General Construction',
          'Interior Design',
          'Premium Finishing',
          'Smart Home Setup',
          'Other'
        ]
        && data.message is string
        && data.message.size() <= 2000
        // A lead must always start as "new" — the public can't submit a
        // pre-marked-contacted lead — and createdAt must be the server's
        // own timestamp, not a client-supplied value.
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    // Fields the admin Projects tab is allowed to set on creation.
    function isValidNewProject(data) {
      return data.keys().hasOnly(['title', 'category', 'description', 'imageUrl', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.category is string
        && data.category in [
          'General Construction',
          'Interior Design',
          'Premium Finishing',
          'Smart Home Setup'
        ]
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 2000
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.imageUrl.size() <= 2000
        && data.createdAt == request.time;
    }

    // The single global_settings document is fully optional field-by-field
    // (the form always sends all five, but this stays lenient either way).
    // `phones` is a list of {label, number} maps — Firestore rules can't
    // validate each list element's shape without loops, so this only bounds
    // the list itself; the doc is admin-write-only anyway.
    function isValidSettings(data) {
      return data.keys().hasOnly(['email', 'phones', 'address', 'facebookUrl', 'instagramUrl'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phones' in data) || (data.phones is list && data.phones.size() <= 10))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('facebookUrl' in data) || (data.facebookUrl is string && data.facebookUrl.size() <= 300))
        && (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 300));
    }

    match /leads/{leadId} {
      // Anyone can submit a lead through the public contact form, as long
      // as the payload matches the shape the form actually sends.
      allow create: if isValidNewLead(request.resource.data);

      // Only signed-in admins can view the leads list/dashboard.
      allow read: if isSignedIn();

      // Admins may only flip the status badge between "new" and
      // "contacted" — no other field can be edited from the client.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted'];

      // Admins can delete a lead from the dashboard.
      allow delete: if isSignedIn();
    }

    match /projects/{projectId} {
      // Portfolio is public — anyone visiting the site can view it.
      allow read: if true;

      // Only signed-in admins can add a project, and only in the shape the
      // admin Projects form actually sends (image already uploaded to ImgBB).
      allow create: if isSignedIn() && isValidNewProject(request.resource.data);

      // Admins can delete a project from the dashboard.
      allow delete: if isSignedIn();
    }

    match /settings/global_settings {
      // Public site reads this to render contact info in the footer/contact
      // section.
      allow read: if true;

      // Only signed-in admins can update site-wide contact info.
      allow create, update: if isSignedIn() && isValidSettings(request.resource.data);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
